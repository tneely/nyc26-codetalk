{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "declaration": true,

    "sourceMap": true,
    "inlineSources": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "isolatedModules": true,

    "experimentalDecorators": true,

    "types": ["node"]
  },
  "exclude": ["node_modules", "cdk.out"]
}
